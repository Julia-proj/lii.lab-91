# MongoDB
MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/liilab

# NextAuth v5 — AUTH_SECRET es obligatorio (reemplaza NEXTAUTH_SECRET)
# Genera uno con: openssl rand -base64 32
AUTH_SECRET=your-random-secret-here
# Solo necesario si no usas Vercel (en Vercel se detecta automático)
# NEXTAUTH_URL=https://tu-dominio.vercel.app

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Stripe (SOLO para Guía)
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_GUIDE_PRICE_ID=price_...

# Email (Gmail SMTP)
EMAIL_FROM=lii.lab.space@gmail.com
EMAIL_PASSWORD=your-gmail-app-password

# Admin
ADMIN_EMAIL=lii.lab.space@gmail.com
ADMIN_WHATSAPP=+34692569848

# Base URL
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Twilio WhatsApp (opcional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# CallMeBot (opcional)
CALLMEBOT_API_KEY=

# Cron Secret
CRON_SECRET=your-cron-secret
